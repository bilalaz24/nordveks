
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nordveks",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "nordveks.se/*",
      "zone_name": "nordveks.se"
    },
    {
      "pattern": "*.nordveks.se/*",
      "zone_name": "nordveks.se"
    }
  ]
}
